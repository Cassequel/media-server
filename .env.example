# Copy values into the local .env; never commit real keys.
ROCKFLIX_FILTERING_ENABLED=false
DOESTHEDOGDIE_API_KEY=
# Explicit pilot allowlist only; leave empty to use the existing provider alone.
ROCKFLIX_CLEANSTREAM_PILOT_TMDB_IDS=
ROCKFLIX_WEBHOOK_SECRET=
# Enable this path during the reviewed rollout; the media mount must be present.
ROCKFLIX_CACHE_PATH=/mnt/media/Rockflix/.stream-cache
ROCKFLIX_CACHE_MAX_BYTES=8589934592
# Optional pinned rollout images and paths, for hosts whose media root is not writable.
ROCKFLIX_API_IMAGE=rockflix-api
ROCKFLIX_CLIENT_IMAGE=rockflix-client
ROCKFLIX_FILTERING_LIBRARY_PATH=/mnt/media/Rockflix/Movies
ROCKFLIX_FILTERING_WORK_PATH=/mnt/media/Rockflix/.processing
